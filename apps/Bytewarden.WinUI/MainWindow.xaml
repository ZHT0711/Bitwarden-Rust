<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Bytewarden.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Bytewarden"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" RowDefinitions="Auto,*" SizeChanged="WindowRoot_SizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut_Invoked" />
        </Grid.KeyboardAccelerators>
        <TitleBar
            x:Name="AppTitleBar"
            Title="Bytewarden"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="216"
            PaneDisplayMode="Auto"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="VaultNavigationItem" Content="我的保险库" IsSelected="True" Tag="vault">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FolderManagementNavigationItem" Content="我的文件夹" Tag="folder-manager" AutomationProperties.AutomationId="FolderManagementNavigationItem">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="收藏夹" Tag="favorites">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="登录" Tag="logins">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="安全笔记" Tag="notes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="银行卡" Tag="cards">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="身份信息" Tag="identities">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="SSH 密钥" Tag="ssh">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="银行账户" Tag="bankaccounts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE825;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="驾驶执照" Tag="licenses">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE804;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="护照" Tag="passports">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE909;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="归档" Tag="archived">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="回收站" Tag="trash">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Send" Tag="sends" AutomationProperties.AutomationId="SendNavigationItem">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE724;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="密码生成器" Tag="generator">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid RowDefinitions="Auto,Auto,*">
                <Grid x:Name="TopCommandBar" Padding="20,8,20,2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*" MaxWidth="520" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        PlaceholderText="搜索保险库"
                        QueryIcon="Find"
                        IsEnabled="False"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="搜索保险库、文件夹或 Send"
                        AutomationProperties.AutomationId="VaultSearchBox"
                        ToolTipService.ToolTip="搜索（Ctrl+F）"
                        TextChanged="SearchBox_TextChanged"
                        Loaded="SearchBox_Loaded"
                        Unloaded="SearchBox_Unloaded"
                        QuerySubmitted="SearchBox_QuerySubmitted" />
                    <StackPanel x:Name="AccountCommands" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button
                            x:Name="SyncButton"
                            Height="32"
                            Padding="10,0"
                            IsEnabled="False"
                            Click="Sync_Click"
                            AutomationProperties.Name="同步"
                            ToolTipService.ToolTip="同步（Ctrl+R）">
                            <Button.KeyboardAccelerators><KeyboardAccelerator Key="R" Modifiers="Control" /></Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock x:Name="SyncButtonLabel" Text="同步" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="LockButton"
                            Height="32"
                            Padding="10,0"
                            Visibility="Collapsed"
                            Click="Lock_Click"
                            AutomationProperties.Name="锁定"
                            ToolTipService.ToolTip="锁定（Ctrl+L）">
                            <Button.KeyboardAccelerators><KeyboardAccelerator Key="L" Modifiers="Control" /></Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="LockButtonIcon" Glyph="&#xE72E;" FontSize="14" />
                                <TextBlock x:Name="LockButtonLabel" Text="锁定" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SignInButton"
                            Height="32"
                            Padding="10,0"
                            Click="SignIn_Click"
                            AutomationProperties.Name="登录">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="AccountIcon" Glyph="&#xE77B;" FontSize="14" />
                                <TextBlock x:Name="AccountPrimaryLabel" Text="登录" MaxWidth="156" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border
                                    x:Name="AccountServerBadge"
                                    Visibility="Collapsed"
                                    Padding="6,1"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="AccountServerLabel"
                                        MaxWidth="128"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <InfoBar x:Name="AccountWarning" Grid.Row="1" Margin="20,6,20,0" Severity="Warning" />
                <Frame x:Name="NavFrame" Grid.Row="2" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
