<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Bytewarden.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="20,10,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="设置" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="应用偏好与安全选项。" VerticalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" Spacing="16">
            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="启动与托盘" />
                    <ToggleSwitch x:Name="StartupToggle" Header="登录 Windows 时启动" IsEnabled="False" Toggled="StartupToggle_Toggled" />
                    <ToggleSwitch x:Name="StartHiddenToggle" Header="自启动时隐藏到系统托盘" Toggled="DesktopOption_Toggled" />
                    <ToggleSwitch x:Name="KeepInTrayToggle" Header="关闭窗口后留在系统托盘" Toggled="DesktopOption_Toggled" />
                    <ToggleSwitch x:Name="MinimizeToTrayToggle" Header="最小化窗口时隐藏到系统托盘" Toggled="DesktopOption_Toggled" />
                    <TextBlock Text="要彻底退出，请右键点击系统托盘中的 Bytewarden 图标并选择退出。" TextWrapping="Wrap" />
                    <TextBlock x:Name="StartupStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="外观" />
                    <ComboBox x:Name="ThemeChoice" Header="应用主题" Width="280" HorizontalAlignment="Left" SelectionChanged="ThemeChoice_Changed">
                        <ComboBoxItem Content="跟随 Windows" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                    <ToggleSwitch x:Name="WebsiteIconsToggle" Header="显示网站图标" />
                    <ToggleSwitch x:Name="QuickCopyActionsToggle" Header="在列表显示快捷复制操作" Toggled="QuickCopyActions_Toggled" />
                    <TextBlock x:Name="ThemeStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="保险库数据" />
                    <Button x:Name="ExportVaultButton" Content="导出个人保险库" Click="ExportVault_Click" IsEnabled="False" />
                    <Button x:Name="ImportVaultButton" Content="导入 Bitwarden JSON / CSV" Click="ImportVault_Click" IsEnabled="False" />
                    <TextBlock x:Name="ExportVaultStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="安全" />
                    <ComboBox x:Name="ClipboardDelayChoice" Header="自动清除剪贴板" Width="280" HorizontalAlignment="Left" SelectionChanged="ClipboardDelay_Changed" />
                    <ToggleSwitch x:Name="MinimizeOnCopyToggle" Header="复制后最小化窗口" Toggled="MinimizeOnCopy_Toggled" />
                    <ToggleSwitch x:Name="PreventScreenshotsToggle" Header="禁止截屏与录屏" Toggled="PreventScreenshots_Toggled" />
                    <TextBlock Text="仅清除本应用仍拥有的内容。锁定、切换账户和退出时仍会尝试清除。" TextWrapping="Wrap" />
                    <TextBlock x:Name="ClipboardStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="PinUnlockButton" Content="启用 PIN 解锁" IsEnabled="False" Click="PinUnlock_Click" AutomationProperties.AutomationId="PinUnlockSettings" />
                    <TextBlock x:Name="PinUnlockStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="HelloUnlockButton" Content="启用 Windows Hello 解锁" IsEnabled="False" Click="HelloUnlock_Click" AutomationProperties.AutomationId="HelloUnlockSettings" />
                    <TextBlock x:Name="HelloUnlockStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <ToggleSwitch x:Name="AutoPromptHelloToggle" Header="锁定时自动弹出 Windows Hello" Toggled="AutoPromptHello_Toggled" />
                    <Button x:Name="ViewFingerprintButton" Content="查看账户指纹短语" IsEnabled="False" Click="ViewFingerprint_Click" />
                    <Button x:Name="RegisterPasskeysButton" Content="注册 Windows 通行密钥提供程序" Click="RegisterPasskeys_Click" AutomationProperties.AutomationId="RegisterPasskeysButton" />
                    <Button Content="打开 Windows 通行密钥设置" Click="OpenPasskeySettings_Click" />
                    <TextBlock x:Name="PasskeyStatus" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="保险库超时" Margin="0,12,0,0" />
                    <ComboBox x:Name="TimeoutModeBox" Header="触发条件" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="VaultTimeoutMode" />
                    <NumberBox x:Name="TimeoutMinutesBox" Header="分钟" Minimum="1" SmallChange="1" LargeChange="15" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="VaultTimeoutMinutes" />
                    <ComboBox x:Name="TimeoutActionBox" Header="超时后" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="VaultTimeoutAction" />
                    <Button x:Name="SaveTimeoutButton" Content="保存超时设置" Click="SaveTimeout_Click" AutomationProperties.AutomationId="SaveVaultTimeout" />
                    <TextBlock x:Name="TimeoutFeedback" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
