<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Bytewarden.WinUI.Pages.SendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:interop="using:Bytewarden.WinUI.Interop">
    <Grid Padding="20,10,20,16" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Send" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" Background="Transparent" VerticalAlignment="Center"
                DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsDynamicOverflowEnabled="True">
                <AppBarButton x:Name="NewSendButton" Icon="Add" Label="新建 Send" IsEnabled="False">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="文本 Send" Click="NewTextSend_Click" />
                            <MenuFlyoutItem Text="文件 Send" Click="NewFileSend_Click" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="OpenSendButton" Icon="View" Label="查看" Click="OpenSend_Click" IsEnabled="False" />
                <AppBarButton x:Name="CopySendButton" Icon="Copy" Label="复制链接" Click="CopySend_Click" IsEnabled="False" />
                <AppBarButton x:Name="DeleteSendButton" Icon="Delete" Label="删除" Click="DeleteSend_Click" IsEnabled="False" />
            </CommandBar>
        </Grid>
        <InfoBar x:Name="SendNotice" Grid.Row="1" IsClosable="True" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="SendCount" VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 个 Send" />
            <ProgressRing x:Name="LoadingRing" Grid.Column="1" Height="24" Width="24" IsActive="False" />
        </Grid>
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListView x:Name="SendList" AutomationProperties.Name="Send 列表" IsItemClickEnabled="True"
                    SelectionChanged="SendList_SelectionChanged" ItemClick="SendList_ItemClick" Padding="4">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="interop:SendSummary">
                            <Grid Padding="10,8" ColumnDefinitions="*,Auto" ColumnSpacing="10"
                                AutomationProperties.Name="{x:Bind AccessibilityName}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind KindLabel}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind StatusLabel}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <TextBlock x:Name="EmptyMessage" Text="登录以查看 Send" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="ConnectButton" Content="连接账户" Click="ConnectAccount_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
