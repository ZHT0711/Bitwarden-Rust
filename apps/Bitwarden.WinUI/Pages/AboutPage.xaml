<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Bitwarden_WinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Bitwarden_WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,8,24,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="关于 Bitwarden Rust" />
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="WinUI 3 桌面客户端原型" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="目标对照版本：Bitwarden Desktop 2026.10.4（本机 MSIX 2026.10.4.0）。" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="账户认证、官方协议兼容与云端同步仍在开发中。" />
        </StackPanel>
    </Grid>
</Page>
