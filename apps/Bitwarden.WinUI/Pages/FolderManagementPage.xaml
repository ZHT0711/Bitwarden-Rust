<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Bitwarden_WinUI.Pages.FolderManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,8,24,24" RowSpacing="14" RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="我的文件夹" />
            <CommandBar Grid.Column="1" Background="Transparent" VerticalAlignment="Center"
                DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsDynamicOverflowEnabled="True">
                <AppBarButton x:Name="CreateFolderButton" Icon="Add" Label="新建文件夹" Click="CreateFolder_Click" IsEnabled="False" />
                <AppBarButton x:Name="RenameFolderButton" Icon="Edit" Label="重命名" Click="RenameSelected_Click" IsEnabled="False" />
                <AppBarButton x:Name="DeleteFoldersButton" Icon="Delete" Label="删除所选" Click="DeleteSelected_Click" IsEnabled="False" />
            </CommandBar>
        </Grid>
        <InfoBar x:Name="ConnectionNotice" Grid.Row="1" IsClosable="True" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="FolderCount" VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 个文件夹" />
            <ProgressRing x:Name="LoadingRing" Grid.Column="1" Width="24" Height="24" IsActive="False" />
        </Grid>
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListView x:Name="FolderList" SelectionMode="Multiple" SelectionChanged="FolderList_SelectionChanged"
                    AutomationProperties.Name="文件夹列表" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,12" ColumnSpacing="14" ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <HyperlinkButton Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Tag="{Binding}" Click="OpenFolder_Click" AutomationProperties.Name="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                    <TextBlock Text="{Binding ItemCountLabel}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="重命名" Tag="{Binding}" Click="RenameRow_Click"
                                    AutomationProperties.Name="重命名文件夹" />
                                <Button Grid.Column="2" Content="删除" Tag="{Binding}" Click="DeleteRow_Click"
                                    AutomationProperties.Name="删除文件夹" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" Margin="24" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8B7;" FontSize="32" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyMessage" Text="登录以查看文件夹" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="ConnectButton" Content="连接账户" Click="ConnectAccount_Click"
                        HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
