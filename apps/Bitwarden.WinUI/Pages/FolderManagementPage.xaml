<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Bitwarden_WinUI.Pages.FolderManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:interop="using:Bitwarden_WinUI.Interop">
    <Grid Padding="20,10,20,16" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*" SizeChanged="FolderLayout_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideFolders" />
                <VisualState x:Name="CompactFolders">
                    <VisualState.Setters>
                        <Setter Target="FolderCommands.(Grid.Row)" Value="1" />
                        <Setter Target="FolderCommands.(Grid.Column)" Value="0" />
                        <Setter Target="FolderCommands.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="FolderCommands.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="我的文件夹" VerticalAlignment="Center" />
            <CommandBar x:Name="FolderCommands" Grid.Column="1" Background="Transparent" VerticalAlignment="Center" MaxWidth="480"
                DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsDynamicOverflowEnabled="True">
                <AppBarButton x:Name="CreateFolderButton" Icon="Add" Label="新建文件夹" Click="CreateFolder_Click" IsEnabled="False">
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="RenameFolderButton" Icon="Edit" Label="重命名" Click="RenameSelected_Click" IsEnabled="False" />
                <AppBarButton x:Name="DeleteFoldersButton" Icon="Delete" Label="删除所选" Click="DeleteSelected_Click" IsEnabled="False" />
            </CommandBar>
        </Grid>
        <InfoBar x:Name="ConnectionNotice" Grid.Row="1" IsClosable="True" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="FolderCount" VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 个文件夹" />
            <ProgressRing x:Name="LoadingRing" Grid.Column="1" Width="24" Height="24" IsActive="False" />
        </Grid>
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListView x:Name="FolderList" SelectionMode="Multiple" SelectionChanged="FolderList_SelectionChanged"
                    AutomationProperties.Name="文件夹列表" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                            <DataTemplate x:DataType="interop:FolderRow">
                            <Grid Padding="10,12" ColumnSpacing="14" ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <HyperlinkButton Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Tag="{x:Bind}" Click="OpenFolder_Click" AutomationProperties.Name="{x:Bind OpenLabel}"
                                        AutomationProperties.AutomationId="{x:Bind OpenAutomationId}">
                                        <TextBlock Text="{x:Bind DisplayText}" AutomationProperties.Name="{x:Bind DisplayName}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                    <TextBlock Text="{x:Bind ItemCountLabel}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="重命名" Tag="{x:Bind}" Click="RenameRow_Click"
                                    IsEnabled="{x:Bind CanEdit}" AutomationProperties.Name="{x:Bind RenameLabel}" />
                                <Button Grid.Column="2" Content="删除" Tag="{x:Bind}" Click="DeleteRow_Click"
                                    IsEnabled="{x:Bind CanEdit}" AutomationProperties.Name="{x:Bind DeleteLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" Margin="24" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8B7;" FontSize="32" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyMessage" Text="登录以查看文件夹" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="ConnectButton" Content="连接账户" Click="ConnectAccount_Click"
                        HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
