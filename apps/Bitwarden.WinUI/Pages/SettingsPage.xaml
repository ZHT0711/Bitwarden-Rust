<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Bitwarden_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24,8,24,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="应用偏好与安全选项。" />
        </StackPanel>
        <StackPanel Grid.Row="1" MaxWidth="720" Spacing="16">
            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="外观" />
                    <ComboBox Header="应用主题" SelectedIndex="0" Width="280" HorizontalAlignment="Left">
                        <ComboBoxItem Content="跟随 Windows" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="此预览使用 Windows 系统 Fluent 主题。主题持久化将在后续迭代加入。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="安全" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="登录后可从窗口顶部手动锁定保险库，并使用主密码解锁。关闭应用会结束当前会话。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
